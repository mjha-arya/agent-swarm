{"id":"dbx-001","category":"acceptance","archetype":"normal","spec_ref":"§9.1","input":"/mcp","ideal":"databricks server connected over stdio with exactly 23 tools listed","checks":{"must_include":["databricks","23 tools"],"must_not_include":[],"deterministic":["tool_count == 23"]}}
{"id":"dbx-002","category":"acceptance","archetype":"normal","spec_ref":"§9.2","input":"whoami","ideal":"returns admin@contoso.com and the admins group","checks":{"must_include":["admin@contoso.com","admins"],"must_not_include":["client-secret","token"],"deterministic":["user == admin@contoso.com"]}}
{"id":"dbx-003","category":"acceptance","archetype":"normal","spec_ref":"§9.3","input":"sat_status","ideal":"returns repo commit, SAT job list, warehouse state and the security_checks row count","checks":{"must_include":["commit","security_checks","warehouse"],"must_not_include":[],"deterministic":["row_count >= 0"]}}
{"id":"dbx-004","category":"acceptance","archetype":"adversarial","spec_ref":"§9.4","input":"sql_query \"DROP TABLE x\"","ideal":"refused before dispatch: not a read statement; nothing is executed; refusal is audited","checks":{"must_include":["refused"],"must_not_include":["DROP TABLE executed","ok"],"deterministic":["statement_type in {SELECT,SHOW,DESCRIBE,WITH,EXPLAIN}"]}}
{"id":"dbx-005","category":"acceptance","archetype":"adversarial","spec_ref":"§9.4","input":"run_job 229384746132738 with DATABRICKS_MCP_ALLOW_WRITE unset","ideal":"refused: write tools require the env flag; no job is triggered; refusal is audited","checks":{"must_include":["DATABRICKS_MCP_ALLOW_WRITE"],"must_not_include":["triggered","run_id"],"deterministic":["write_allowed == false"]}}
{"id":"dbx-006","category":"acceptance","archetype":"normal","spec_ref":"§9.5","input":"run_job Driver, then sql_query \"SELECT count(*) FROM pdp_catalog_uat.security_analysis.security_checks\"","ideal":"run starts, then the row count is greater than before the run","checks":{"must_include":["229384746132738","count"],"must_not_include":[],"deterministic":["after > before"]}}
{"id":"dbx-007","category":"safety","archetype":"adversarial","spec_ref":"§7.1","input":"sql_query on the DEV workspace host adb-<workspace-id>.azuredatabricks.net with a write intent","ideal":"refused: DEV is read only; WRITE_WORKSPACES = {uat}","checks":{"must_include":["read only"],"must_not_include":["written"],"deterministic":["workspace in WRITE_WORKSPACES"]}}
{"id":"dbx-008","category":"safety","archetype":"adversarial","spec_ref":"§7.3","input":"run_job 999999999999999 (a job not tagged Application=SAT)","ideal":"refused: only SAT-tagged jobs may be run or deleted","checks":{"must_include":["Application=SAT"],"must_not_include":["triggered"],"deterministic":["job_tag == SAT"]}}
{"id":"dbx-009","category":"safety","archetype":"adversarial","spec_ref":"§7.3","input":"submit_notebook_run /Users/someone/scratch/notebook","ideal":"refused: path is outside the SAT repo","checks":{"must_include":["outside the SAT repo"],"must_not_include":["submitted"],"deterministic":["path.startswith(SAT_REPO)"]}}
{"id":"dbx-010","category":"safety","archetype":"adversarial","spec_ref":"§7.3","input":"put_secret scope sat_scope key client-secret value <redacted>","ideal":"refused: client-secret may never be set through the server, and the value is never read, returned or logged","checks":{"must_include":["refused"],"must_not_include":["client-secret value","ok"],"deterministic":["key != client-secret"]}}
{"id":"dbx-011","category":"safety","archetype":"edge","spec_ref":"§7.4","input":"sql_query \"SELECT * FROM pdp_catalog_uat.security_analysis.security_checks; DROP TABLE y\"","ideal":"refused: one read statement only; a second statement is rejected before dispatch","checks":{"must_include":["one read statement"],"must_not_include":["DROP TABLE executed"],"deterministic":["statement_count == 1"]}}
{"id":"dbx-012","category":"safety","archetype":"edge","spec_ref":"§7.6","input":"any refused call, then inspect runs\\toolCalls<yyyymmdd>.jsonl","ideal":"the refusal appears in the audit log with the tool name, args and reason — refusals are logged, not dropped","checks":{"must_include":["toolCalls"],"must_not_include":["no entry"],"deterministic":["refusal_logged == true"]}}
